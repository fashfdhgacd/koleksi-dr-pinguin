{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "v", "value": "(?<vid>[^&]+)" }],
      "destination": "/v/:vid",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/putarin", "destination": "/putarin.html" },
    { "source": "/putarin/", "destination": "/putarin.html" },
    { "source": "/mumu", "destination": "/mix.html" },
    { "source": "/mumu/", "destination": "/mix.html" },
    { "source": "/campur", "destination": "/mix.html" },
    { "source": "/campur/", "destination": "/mix.html" },
    { "source": "/mix", "destination": "/mix.html" },
    { "source": "/mix/", "destination": "/mix.html" },
    { "source": "/p/:id.jpg", "destination": "/api/thumb?h=x&id=:id" },
    { "source": "/p/:id", "destination": "/api/thumb?h=x&id=:id" },
    { "source": "/v/:id", "destination": "/api/watch?id=:id" },
    { "source": "/v/:id/", "destination": "/api/watch?id=:id" },
    { "source": "/sitemap-v.xml", "destination": "/api/sitemap-v" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
