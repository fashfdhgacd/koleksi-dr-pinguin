{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "rewrites": [
    { "source": "/putarin", "destination": "/putarin.html" },
    { "source": "/putarin/", "destination": "/putarin.html" },
    { "source": "/mumu", "destination": "/mumu.html" },
    { "source": "/mumu/", "destination": "/mumu.html" },
    { "source": "/campur", "destination": "/mumu.html" },
    { "source": "/campur/", "destination": "/mumu.html" },
    { "source": "/mix", "destination": "/mumu.html" },
    { "source": "/mix/", "destination": "/mumu.html" },
    { "source": "/v/:id", "destination": "/api/watch?id=:id" },
    { "source": "/v/:id/", "destination": "/api/watch?id=:id" },
    { "source": "/sitemap-v.xml", "destination": "/api/sitemap-v" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
